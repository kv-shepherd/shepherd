# =============================================================================
# KubeVirt Shepherd — Production Environment Variables
# Optimized for deploy/prod/deploy-prod.sh.
#
# Recommended first-run flow:
#   1. Copy this file to .env.prod
#   2. If you use an external PostgreSQL service, set DATABASE_URL and
#      DEPLOY_BUNDLED_POSTGRES=false
#   3. Run: bash deploy/prod/deploy-prod.sh --with-seed
#
# Blank values below are intentional. The deploy script can generate the
# missing first-run credentials and production security secrets, then persist
# them back to .env.prod before starting release-mode services.
# =============================================================================

# ---- Release images ----
# Leave empty when using deploy-prod.sh; it resolves and persists the image refs.
# For manual docker compose, set full image references explicitly.
# Example: ghcr.io/kv-shepherd/shepherd-server:<version>
SERVER_IMAGE=
WEB_IMAGE=

# ---- Bundled PostgreSQL (ignored when using an external database) ----
POSTGRES_IMAGE=postgres:18
POSTGRES_USER=shepherd
# Leave empty to auto-generate a strong password on first deploy and persist it
# back to .env.prod. If you set this manually, keep DATABASE_URL in sync.
# Manual example: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=shepherd_db

# ---- Database topology ----
# Leave empty to let deploy-prod.sh build a bundled PostgreSQL DSN from the
# POSTGRES_* values above. For an external PostgreSQL service, paste the full
# DSN here and set DEPLOY_BUNDLED_POSTGRES=false.
DATABASE_URL=
# - auto  => use bundled PostgreSQL when DATABASE_URL is empty or points to "db"
# - true  => always start bundled PostgreSQL and rewrite DATABASE_URL to match it
# - false => never start bundled PostgreSQL; DATABASE_URL must point to external PostgreSQL
DEPLOY_BUNDLED_POSTGRES=auto

# ---- Security bootstrap secrets ----
# Leave empty to auto-generate a strong release-mode session secret on first
# deploy and persist it back to .env.prod.
# Manual example: openssl rand -hex 32
SECURITY_SESSION_SECRET=
# Leave empty to auto-generate a hex-encoded AES-256 key on first deploy and
# persist it back to .env.prod. Keep this value backed up.
# Manual example: openssl rand -hex 32
SECURITY_ENCRYPTION_KEY=

# ---- Server ----
SERVER_PORT=8080
# Blank defaults to https://localhost on first deploy. Set this to the
# external HTTPS URL users will open when you have a real domain or ingress.
SERVER_PUBLIC_BASE_URL=
# Leave empty to automatically allow the SERVER_PUBLIC_BASE_URL origin only.
SERVER_ALLOWED_ORIGINS=
SERVER_ALLOW_CREDENTIALS=true
SERVER_UNSAFE_ALLOW_ALL_ORIGINS=false
GIN_MODE=release

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Schema management ----
# Versioned Atlas migrations run automatically before the server starts.
DATABASE_AUTO_APPLY_VERSIONED_MIGRATIONS=true
# Ent auto-migrate remains a dev-only fallback and should stay disabled here.
DATABASE_AUTO_MIGRATE=false

# ---- Worker ----
RIVER_MAX_WORKERS=10
RIVER_COMPLETED_JOB_RETENTION_PERIOD=24h
WORKER_GENERAL_POOL_SIZE=100
WORKER_K8S_POOL_SIZE=50

# ---- Observability ----
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_PATH=/metrics
OBSERVABILITY_DATABASE_METRICS_ENABLED=true
OBSERVABILITY_DATABASE_METRICS_TIMEOUT=2s
OBSERVABILITY_RIVER_METRICS_ENABLED=true
OBSERVABILITY_RIVER_METRICS_TIMEOUT=2s
OBSERVABILITY_BUSINESS_METRICS_ENABLED=true
OBSERVABILITY_BUSINESS_METRICS_TIMEOUT=2s
OBSERVABILITY_TRACING_ENABLED=false
OBSERVABILITY_TRACING_SERVICE_NAME=shepherd
OBSERVABILITY_TRACING_EXPORTER=otlp_http
OBSERVABILITY_TRACING_SAMPLE_RATIO=0.10
OBSERVABILITY_TRACING_SHUTDOWN_TIMEOUT=5s
OBSERVABILITY_TRACE_QUERY_ENABLED=false
OBSERVABILITY_TRACE_QUERY_URL=http://tempo:3200
OBSERVABILITY_TRACE_QUERY_TIMEOUT=3s
OBSERVABILITY_TRACE_QUERY_LIMIT=100
OBSERVABILITY_TRACE_QUERY_LOOKBACK=1h
# Standard OpenTelemetry exporter environment. Set these to the bundled
# OpenTelemetry Collector values when enabling the monitoring overlay.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=

# ---- Optional monitoring overlay ----
# Required only when deploy/prod/docker-compose.monitoring.yml is enabled.
PROMETHEUS_IMAGE=
PROMETHEUS_PORT=9090
TEMPO_IMAGE=
TEMPO_PORT=3200
OTEL_COLLECTOR_IMAGE=

# ---- Initial admin bootstrap ----
# Leave empty to auto-generate a strong first-run password for the seeded
# "admin" account and persist it back to .env.prod.
# Manual example: openssl rand -hex 16
DEV_ADMIN_PASSWORD=

# ---- Frontend ----
NEXT_PUBLIC_API_URL=/api/v1
NODE_ENV=production
INTERNAL_API_URL=http://server:8080

# ---- Edge ports ----
NGINX_IMAGE=nginx:1.30.1-alpine
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ---- Enterprise (optional; used only with --enterprise) ----
# ENTERPRISE_PORT=18081
# ENTERPRISE_DATABASE_URL=postgres://shepherd:CHANGE_ME@db:5432/shepherd_db?sslmode=disable
