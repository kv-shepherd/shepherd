# =============================================================================
# KubeVirt Shepherd — Production Environment Variables
# Copy to .env.prod and fill in real values before deployment.
# =============================================================================

# ---- Database ----
# POSTGRES_* values are used only when the bundled PostgreSQL topology is enabled.
POSTGRES_USER=shepherd
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=shepherd_db
DATABASE_URL=postgres://shepherd:CHANGE_ME_TO_STRONG_PASSWORD@db:5432/shepherd_db?sslmode=disable
# Database topology for deploy-prod.sh:
# - auto  => use bundled db only when DATABASE_URL host is "db"
# - true  => always start bundled PostgreSQL service
# - false => assume DATABASE_URL points to an external PostgreSQL service
DEPLOY_BUNDLED_POSTGRES=auto

# ---- Security (generate with: openssl rand -hex 32) ----
SECURITY_SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
SECURITY_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# ---- Server ----
SERVER_PORT=8080
SERVER_PUBLIC_BASE_URL=https://your-domain.com
SERVER_ALLOWED_ORIGINS=https://your-domain.com
SERVER_ALLOW_CREDENTIALS=true
SERVER_UNSAFE_ALLOW_ALL_ORIGINS=false
GIN_MODE=release

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Database Auto Migration ----
# Set to true on first deployment, then switch to false for manual migration control.
DATABASE_AUTO_MIGRATE=true

# ---- Worker ----
RIVER_MAX_WORKERS=10
RIVER_COMPLETED_JOB_RETENTION_PERIOD=24h
WORKER_GENERAL_POOL_SIZE=100
WORKER_K8S_POOL_SIZE=50

# ---- Dev Admin (initial seed) ----
DEV_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ---- Frontend ----
NEXT_PUBLIC_API_URL=/api/v1
NODE_ENV=production
INTERNAL_API_URL=http://server:8080

# ---- Enterprise (optional — only for enterprise deployment) ----
# ENTERPRISE_PORT=18081
# ENTERPRISE_DATABASE_URL=postgres://shepherd:CHANGE_ME@db:5432/shepherd_db?sslmode=disable
