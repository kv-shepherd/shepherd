{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/run-next-build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip --max-show-issues 200",
    "typecheck": "rm -f tsconfig.tsbuildinfo && node scripts/run-next-typecheck.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:local": "node scripts/run-vitest-local.mjs",
    "test:coverage": "vitest run --coverage",
    "i18n:schema-help:audit": "node scripts/audit-schema-help.mjs",
    "i18n:schema-help:ci": "node scripts/audit-schema-help.mjs --ci",
    "test:e2e": "playwright test --project=smoke-chromium",
    "test:e2e:mock": "playwright test --project=smoke-chromium",
    "test:e2e:smoke": "playwright test --project=smoke-chromium",
    "test:e2e:live": "LIVE_E2E=true playwright test --project=live-chromium",
    "test:e2e:all": "LIVE_E2E=true playwright test",
    "api:generate": "openapi-typescript ../api/openapi.yaml -o src/types/api.gen.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@novnc/novnc": "^1.6.0",
    "@tanstack/react-query": "^5.95.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^5.29.3",
    "dayjs": "^1.11.20",
    "i18next": "^25.10.9",
    "i18next-browser-languagedetector": "^8.2.1",
    "next": "^16.2.3",
    "nextjs-toploader": "^3.9.17",
    "openapi-fetch": "^0.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/eslint-plugin-query": "^5.95.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "js-yaml": "^4.2.0",
    "jsdom": "^28.1.0",
    "knip": "^6.0.5",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "vite": "8.0.16",
    "flatted": "^3.4.2",
    "@ant-design/pro-layout": {
      "path-to-regexp": "8.4.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    },
    "@redocly/openapi-core": {
      "minimatch": "^5.1.8"
    },
    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "tinyglobby": {
      "picomatch": "^4.0.4"
    },
    "postcss": "^8.5.10"
  }
}
